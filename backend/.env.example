# ==============================================================================
# SIH26034 - Legal Metrology Packaged Commodities Compliance System
# Backend Environment Configuration Template
# ==============================================================================

# Application
APP_NAME="Legal Metrology Compliance Inspection System API"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Security & Authentication
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL supported; SQLite supported for local testing)
# PostgreSQL Example: postgresql+psycopg://user:password@localhost:5432/legal_metrology_db
# SQLite Example: sqlite:///./legal_metrology.db
DATABASE_URL="sqlite:///./legal_metrology.db"

# Storage Settings
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=15

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Rule Engine Settings
DEFAULT_RULE_VERSION="2011.1"
STRICT_OCR_CONFIDENCE_THRESHOLD=80.0
